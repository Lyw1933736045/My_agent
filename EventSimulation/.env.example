# My_agent PostgreSQL (read-only account)
DATABASE_URL=postgresql://readonly_user:password@127.0.0.1:5432/my_agent

# Zep Cloud graph and managed embeddings
ZEP_API_KEY=your-zep-cloud-api-key

# OpenAI-compatible model endpoint, used by Zep extraction and OASIS/CAMEL
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-flash
# OASIS runtime
OASIS_SEMAPHORE=10
