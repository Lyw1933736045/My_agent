# ============================================================
# Financial Single Agent 环境变量示例
# ============================================================
# 使用方法：
#   1. 将本文件复制为 .env：
#        cp .env.example .env
#   2. 在 .env 中填写真实密钥。
#   3. 不要提交 .env；项目的 .gitignore 已忽略它。
#
# 本项目只读取当前 financial_single_agent 目录下的 .env，
# 不会读取 BettaFish 或其他项目中的环境文件。


# ==================== LLM 接口配置（必填） ====================

# OpenAI 兼容接口的 API Key。
# 可以使用 OpenAI、DeepSeek 或其他兼容 Chat Completions API 的服务。
# 示例仅表示格式，请勿把真实密钥写入 .env.example：
# QUERY_ENGINE_API_KEY=sk-your-api-key
QUERY_ENGINE_API_KEY=

# OpenAI 兼容接口的 Base URL。
# 使用 OpenAI 官方接口时可以留空。
# DeepSeek 示例：https://api.deepseek.com
# 其他服务请填写其文档提供的 OpenAI 兼容地址。
QUERY_ENGINE_BASE_URL=

# 接口实际支持的模型名称，必须与上面的服务商匹配。
# DeepSeek 常用示例：deepseek-chat
# OpenAI 示例：gpt-4.1-mini
QUERY_ENGINE_MODEL_NAME=deepseek-chat

# 评测 Judge（覆盖评测脚本 scripts/eval_reference_coverage.py）
# 简报生成继续用上面的 QUERY_ENGINE_MODEL_NAME=deepseek-chat。
# 评测默认 deepseek-v4-flash；JUDGE_USE_QUERY_ENGINE_API=true 时复用
# QUERY_ENGINE 的 key/base_url，但模型仍用 JUDGE_MODEL_NAME。
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL_NAME=deepseek-v4-flash
JUDGE_USE_QUERY_ENGINE_API=false
JUDGE_LLM_REQUEST_TIMEOUT=300
EVAL_JUDGE_RUNS=3
EVAL_JUDGE_TEMPERATURE=0.7

# 单次 LLM 请求超时时间，单位为秒。
# 金融研究报告输出较长，建议设置为 300 秒或更高。
LLM_REQUEST_TIMEOUT=300


# ==================== 网页搜索配置（必填） ====================

# Tavily API Key（本阶段 Example 不启用，可留空）。
# 申请地址：https://www.tavily.com/
# 示例：TAVILY_API_KEY=tvly-your-api-key
TAVILY_API_KEY=

# ==================== PostgreSQL 主数据库 ====================

# 项目所有运行记录、候选新闻和新闻完整正文都写入 PostgreSQL。
# 首次使用前执行：alembic upgrade head
# 示例：postgresql+psycopg://postgres:password@127.0.0.1:5432/my_agent
DATABASE_URL=

# ==================== Qwen Embedding / Rerank（Dense RAG） ====================
# 阿里云百炼 API Key。Embedding 与 Rerank 共用，也可分别覆盖。
DASHSCOPE_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
RERANKER_API_KEY=
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RERANKER_MODEL=qwen3-rerank

# 本阶段 Example 只启用 NewsNow 和 RSS；Tavily、微博等不参与运行。


# ==================== RSSHub 基址（媒体 RSS 必填） ====================

# media_sources.yaml 里的 ${RSSHUB_BASE}/... 会替换成这个地址。
# 本机 Docker 示例：http://localhost:1200
# 公共实例示例：https://rsshub.app
RSSHUB_BASE=http://localhost:1200

# ==================== 微博 Cookie（可选） ====================

# 只填写 Cookie 文件路径，不要把 Cookie 内容写入 .env。
# 例如：WEIBO_COOKIE_FILE=/Users/你的用户名/Desktop/projects/weibo_cookie.txt
WEIBO_COOKIE_FILE=


# ==================== 研究规模配置（可选） ====================

# 每个报告章节完成初次总结后，再进行多少轮“检查缺口 → 补充搜索 → 更新总结”。
# 设为 0：不执行反思搜索，速度最快、调用成本最低。
# 建议第一版使用 1；数值越大，LLM 和 Tavily 调用次数越多。
MAX_REFLECTIONS=1

# LLM 为一个问题规划的最大报告章节数。
# 建议范围：3～5。章节越多，研究时间和 API 成本越高。
MAX_PARAGRAPHS=4

# 每次 Tavily 搜索最多返回多少条结果。
# 建议范围：5～10。过多结果会增加提示词长度。
MAX_SEARCH_RESULTS=7

# 单个章节传给 LLM 的全部搜索正文字符预算。
# 程序会在多条结果之间分配该预算，同时始终保留标题、URL、来源和发布时间。
SEARCH_CONTENT_MAX_LENGTH=20000


# ==================== 报告输出配置（可选） ====================

# Markdown 报告和研究状态 JSON 的输出目录。
# 相对路径以运行命令时的当前工作目录为基准。
# 如需固定位置，也可以填写绝对路径。
OUTPUT_DIR=reports

# 是否在保存 Markdown 报告时，同时保存完整研究状态 JSON。
# 可用值：true / false
# 使用 --no-save 启动时，Markdown 和状态 JSON 都不会写入磁盘。
SAVE_INTERMEDIATE_STATES=true
