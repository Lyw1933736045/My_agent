# ============================================================
# Financial Single Agent 环境变量示例
# ============================================================
# 使用方法：
#   1. 将本文件复制为 .env：
#        cp .env.example .env
#   2. 在 .env 中填写真实密钥。
#   3. 不要提交 .env；项目的 .gitignore 已忽略它。
#
# 本项目只读取当前 financial_single_agent 目录下的 .env，
# 不会读取 BettaFish 或其他项目中的环境文件。


# ==================== LLM 接口配置（必填） ====================

# OpenAI 兼容接口的 API Key。
# 可以使用 OpenAI、DeepSeek 或其他兼容 Chat Completions API 的服务。
# 示例仅表示格式，请勿把真实密钥写入 .env.example：
# QUERY_ENGINE_API_KEY=sk-your-api-key
QUERY_ENGINE_API_KEY=

# OpenAI 兼容接口的 Base URL。
# 使用 OpenAI 官方接口时可以留空。
# DeepSeek 示例：https://api.deepseek.com
# 其他服务请填写其文档提供的 OpenAI 兼容地址。
QUERY_ENGINE_BASE_URL=

# 接口实际支持的模型名称，必须与上面的服务商匹配。
# DeepSeek 常用示例：deepseek-chat
# OpenAI 示例：gpt-4.1-mini
QUERY_ENGINE_MODEL_NAME=deepseek-chat

# 单次 LLM 请求超时时间，单位为秒。
# 金融研究报告输出较长，建议设置为 300 秒或更高。
LLM_REQUEST_TIMEOUT=300


# ==================== 网页搜索配置（必填） ====================

# Tavily API Key，用于搜索金融政策、公开公告、财经新闻和机构观点。
# 申请地址：https://www.tavily.com/
# 示例：TAVILY_API_KEY=tvly-your-api-key
TAVILY_API_KEY=

# 当前第一版只支持 Tavily，不需要配置 Bocha、Anspire 或其他搜索服务。


# ==================== 研究规模配置（可选） ====================

# 每个报告章节完成初次总结后，再进行多少轮“检查缺口 → 补充搜索 → 更新总结”。
# 设为 0：不执行反思搜索，速度最快、调用成本最低。
# 建议第一版使用 1；数值越大，LLM 和 Tavily 调用次数越多。
MAX_REFLECTIONS=1

# LLM 为一个问题规划的最大报告章节数。
# 建议范围：3～5。章节越多，研究时间和 API 成本越高。
MAX_PARAGRAPHS=4

# 每次 Tavily 搜索最多返回多少条结果。
# 建议范围：5～10。过多结果会增加提示词长度。
MAX_SEARCH_RESULTS=7

# 单个章节传给 LLM 的全部搜索正文字符预算。
# 程序会在多条结果之间分配该预算，同时始终保留标题、URL、来源和发布时间。
SEARCH_CONTENT_MAX_LENGTH=20000


# ==================== 报告输出配置（可选） ====================

# Markdown 报告和研究状态 JSON 的输出目录。
# 相对路径以运行命令时的当前工作目录为基准。
# 如需固定位置，也可以填写绝对路径。
OUTPUT_DIR=reports

# 是否在保存 Markdown 报告时，同时保存完整研究状态 JSON。
# 可用值：true / false
# 使用 --no-save 启动时，Markdown 和状态 JSON 都不会写入磁盘。
SAVE_INTERMEDIATE_STATES=true
